{
  "name": "MKAsh PMS",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "containerEnv": {
    "Database__Provider": "Sqlite",
    "ConnectionStrings__Pms": "Data Source=/workspaces/.tamkeen/tamkeen.db"
  },
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "MKAsh PMS (open this)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash scripts/dev-setup.sh",
  "postStartCommand": "bash scripts/dev-start.sh",
  "postAttachCommand": "bash -c 'curl -sf http://localhost:5173/api/health >/dev/null || bash scripts/dev-start.sh'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
