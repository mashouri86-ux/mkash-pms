# "dev"  = pick a demo user on the sign-in page (needs the API in Development mode)
# "entra" = Microsoft Entra ID sign-in (production)
VITE_AUTH_MODE=dev
VITE_ENTRA_CLIENT_ID=<web-app-registration-client-id>
VITE_ENTRA_TENANT_ID=<ministry-tenant-id>
VITE_API_SCOPE=api://<api-app-registration-client-id>/access_as_user
